{
  "name": "interaction-vault",
  "version": "1.0.0",
  "description": "MCP server that gives an AI assistant taste for web interactions",
  "type": "module",
  "bin": {
    "interaction-vault": "dist/cli.js"
  },
  "files": [
    "dist",
    "vault"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js --http",
    "check:vault": "tsx scripts/check-vault.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test \"test/*.test.ts\""
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
